msgstr "Esse nome de exibição já existe!"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:534
msgid "Added: {}"
msgstr "Adicionado: {}"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:549
