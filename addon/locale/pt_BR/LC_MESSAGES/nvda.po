msgstr "Arquivo não encontrado"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:560
msgid "Enter new display name"
msgstr "Entre com um nome de referência para o arquivo"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:588
msgid "Display name updated to {}"
msgstr "Nome de exibição atualizado para {}"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:598
msgid "Are you sure you want to remove {}?"
msgstr ""
"Você tem certeza que deseja remover {} da sua lista de arquivos favoritos?"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:610
msgid "Removed {}"
msgstr "Removido {}"

#. Translators: Title of add-on, present in the dialog boxes.
#: addon\globalPlugins\favoriteFolders\__init__.py:45
msgid "Favorite folders"
msgstr "Pastas favoritas"

#. For translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\favoriteFolders\__init__.py:153
msgid "Opens a dialog box to register and open favorite folders."
msgstr "Abre uma caixa de diálogo para cadastrar ou abrir uma pasta favorita."

#. Translators: Announced when the focus is not on the Windows Explorer and there is no registered folders.
#: addon\globalPlugins\favoriteFolders\__init__.py:189
msgid ""
"You do not have added folders and is not in the windows explorer window to "
"make a record"
msgstr ""
"Você não tem pastas cadastradas e não está na janela do Explorador de "
"arquivos para efetuar um registro"

#. For translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\favoriteFolders\__init__.py:212
msgid "Opens a dialog box to register and open favorite files."
msgstr "Abre uma caixa de diálogo para cadastrar ou abrir um arquivo favorito."

#: addon\globalPlugins\favoriteFolders\__init__.py:249
msgid "Favorite folders list"
msgstr "Lista de pastas favoritas"

#: addon\globalPlugins\favoriteFolders\__init__.py:268
msgid "Write in the e&dit box"
msgstr "Escrever em caixa¨&de texto"

#: addon\globalPlugins\favoriteFolders\__init__.py:271
msgid "Re&name"
msgstr "Re&nomear"

#. Translators: Message dialog box to add a new folder.
#: addon\globalPlugins\favoriteFolders\__init__.py:328
msgid "Enter a nickname for the folder"
msgstr "Entre com um nome de referência para a pasta"

#. Translators: Announcement that the folder name already exists in the list.
#: addon\globalPlugins\favoriteFolders\__init__.py:359
#: addon\globalPlugins\favoriteFolders\__init__.py:425
msgid "There is already a folder with this nickname!"
msgstr "Já existe uma pasta com esta referência!"

#: addon\globalPlugins\favoriteFolders\__init__.py:373
#, python-format
msgid ""
"Error opening folder:\n"
" %s"
msgstr ""
"Erro abrindo pasta:\n"
" %s"

#: addon\globalPlugins\favoriteFolders\__init__.py:373
msgid "Error"
msgstr "Erro"

#. Translators: Message dialog to rename the nickname  of the selected folder.
#: addon\globalPlugins\favoriteFolders\__init__.py:398
#, python-format
msgid "Enter a new nickname for %s"
msgstr "Entre com um novo nome de referência para %s"

#. Translators: Message dialog box to remove the selected folder.
#: addon\globalPlugins\favoriteFolders\__init__.py:435
#, python-format
msgid "Are you sure you want to remove %s?"
msgstr ""
"Você tem certeza que deseja remover %s da sua lista de pastas favoritas?"

#. Translators: Title of the first column of the list view.
#: addon\globalPlugins\favoriteFolders\__init__.py:514
msgid "Nickname"
msgstr "Referência"

#. Translators: Title of the second column of the list view.
#: addon\globalPlugins\favoriteFolders\__init__.py:521
msgid "Address"
msgstr "Endereço"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:21
msgid "Favorite folders and files - Register favorite folders and files"
msgstr "Pastas e arquivos favoritos - Registre as pastas e arquivos favoritos"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid ""
"Register favorite folders and files to provide quick access to them. "
"Shortcuts:\n"
"WINDOWS+BACKSPACE: Open favorite folders dialog..\n"
"SHIFT+WINDOWS+BACKSPACE: Open favorite files dialog."
msgstr ""
"Registre as pastas  e arquivos favoritos para ter acesso rápido a eles. "
"Atalhos:\n"
"WINDOWS+BACKSPACE: Abre o diálogo das pastas favoritas;\n"
"SHIFT+WINDOWS+BACKSPACE: Abre o diálogo dos arquivos favoritos."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:31
msgid ""
"Set compatibility with NVDA 2026.1;\n"
"Added Chai Chaimee work for favorite files."
msgstr ""
"Definida compatibilidade com NVDA 2026.1;\n"
"Adicionado trabalho de Chai Chaimee para arquivos favoritos."

