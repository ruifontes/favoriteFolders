#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:26
msgid "Favorite files"
msgstr "Arquivos favoritos"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:202
msgid "Folders cannot be added. Only files are allowed."
msgstr "Pastas não podem ser adicionadas. Apenas arquivos são permitidos."

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:215
msgid ""
"You have no favorite files and are not in a Windows Explorer window to add "
"one"
msgstr ""
"Você não tem arquivos cadastrados e não está na janela do Explorador de "
"arquivos para efetuar um registro"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:258
msgid "Display name"
msgstr "Nome de exibição"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:259
