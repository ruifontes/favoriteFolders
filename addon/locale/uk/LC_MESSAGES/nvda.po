#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:26
msgid "Favorite files"
msgstr "Улюблені файли"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:202
msgid "Folders cannot be added. Only files are allowed."
msgstr "Не можна додавати папки. Дозволено лише файли."

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:215
msgid ""
"You have no favorite files and are not in a Windows Explorer window to add "
"one"
msgstr ""
"У вас немає улюблених  файлів, і ви не перебуваєте у вікні Провідника "
"Windows, щоб додати такий файл"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:258
msgid "Display name"
msgstr "Назва"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:259
msgid "Path"
msgstr "Шлях"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:263
#: addon\globalPlugins\favoriteFolders\__init__.py:256
msgid "&Show paths in the list"
msgstr "&Показати шляхи у списку"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:266
msgid "Sort order:"
msgstr "Порядок сортування:"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:270
msgid "Custom order (drag and pin allowed)"
msgstr "Користувацький порядок (дозволено перетягування та закріплення)"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:271
msgid "A-Z (uppercase)"
msgstr "Від А до Я (великі літери)"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:272
msgid "Z-A (lowercase)"
msgstr "Від Я до а (малі літери)"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:288
#: addon\globalPlugins\favoriteFolders\__init__.py:262
msgid "&Add"
msgstr "&Додати"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:289
#: addon\globalPlugins\favoriteFolders\__init__.py:265
msgid "&Open"
msgstr "&Відкрити"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:290
#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:325
msgid "&Edit"
msgstr "&Редагувати"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:291
#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:326
#: addon\globalPlugins\favoriteFolders\__init__.py:274
msgid "&Remove"
msgstr "&Видалити"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:322
#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:398
msgid "&Pin to top"
msgstr "&Закріпити вгорі"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:323
msgid "Move &up"
msgstr "Перемістити &вгору"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:324
msgid "Move &down"
msgstr "Перемістити &вниз"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:396
msgid "&Unpin"
msgstr "&Відкріпити"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:422
#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:431
#, python-brace-format
msgid "Unpinned {}"
msgstr "Відкріплено {}"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:473
#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:487
#, python-brace-format
msgid "Pinned {} to top"
msgstr "Закріплено {} вгорі"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:513
msgid "No file selected to add"
msgstr "Не вибрано жодного файлу для додавання"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:517
msgid "Enter display name for the file"
msgstr "Введіть назву для файлу"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:521
msgid "Display name cannot be empty"
msgstr "Назва не може бути пустою"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:525
#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:567
msgid "This display name already exists!"
msgstr "Ця назва вже існує!"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:534
#, python-brace-format
msgid "Added: {}"
msgstr "Додано: {}"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:549
msgid "File not found"
msgstr "Файл не знайдено"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:560
msgid "Enter new display name"
msgstr "Введіть нову назву"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:588
#, python-brace-format
msgid "Display name updated to {}"
msgstr "Назва змінена на {}"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:598
#, python-brace-format
msgid "Are you sure you want to remove {}?"
msgstr "Ви впевнені, що хочете видалити {}?"

#: addon\globalPlugins\favoriteFolders\init_FavFiles.py:610
#, python-brace-format
msgid "Removed {}"
msgstr "Видалено {}"

#. Translators: Title of add-on, present in the dialog boxes.
#: addon\globalPlugins\favoriteFolders\__init__.py:45
msgid "Favorite folders"
msgstr "Улюблені папки"

#. For translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\favoriteFolders\__init__.py:153
msgid "Opens a dialog box to register and open favorite folders."
msgstr "Відкриває діалог для реєстрації та відкриття улюблених папок."

#. Translators: Announced when the focus is not on the Windows Explorer and there is no registered folders.
#: addon\globalPlugins\favoriteFolders\__init__.py:189
msgid ""
"You do not have added folders and is not in the windows explorer window to "
"make a record"
msgstr ""
"У вас немає зареєстрованих папок, і ви не перебуваєте у вікні Провідника "
"Windows, щоб виконати реєстрацію"

#. For translators: Message to be announced during Keyboard Help
#: addon\globalPlugins\favoriteFolders\__init__.py:212
msgid "Opens a dialog box to register and open favorite files."
msgstr "Відкриває діалог для реєстрації та відкриття улюблених файлів."

#: addon\globalPlugins\favoriteFolders\__init__.py:249
msgid "Favorite folders list"
msgstr "Список улюблених папок"

#: addon\globalPlugins\favoriteFolders\__init__.py:268
msgid "Write in the e&dit box"
msgstr "Написати у полі &редагування"

#: addon\globalPlugins\favoriteFolders\__init__.py:271
msgid "Re&name"
msgstr "Пере&йменувати"

#. Translators: Message dialog box to add a new folder.
#: addon\globalPlugins\favoriteFolders\__init__.py:328
msgid "Enter a nickname for the folder"
msgstr "Введіть псевдонім для папки"

#. Translators: Announcement that the folder name already exists in the list.
#: addon\globalPlugins\favoriteFolders\__init__.py:359
#: addon\globalPlugins\favoriteFolders\__init__.py:425
msgid "There is already a folder with this nickname!"
msgstr "Папка з таким псевдонімом вже існує!"

#: addon\globalPlugins\favoriteFolders\__init__.py:373
#, python-format
msgid ""
"Error opening folder:\n"
" %s"
msgstr ""
"Помилка відкриття папки:\n"
"%s"

#: addon\globalPlugins\favoriteFolders\__init__.py:373
msgid "Error"
msgstr "Помилка"

#. Translators: Message dialog to rename the nickname  of the selected folder.
#: addon\globalPlugins\favoriteFolders\__init__.py:398
#, python-format
msgid "Enter a new nickname for %s"
msgstr "Введіть новий псевдонім для %s"

#. Translators: Message dialog box to remove the selected folder.
#: addon\globalPlugins\favoriteFolders\__init__.py:435
#, python-format
msgid "Are you sure you want to remove %s?"
msgstr "Ви впевнені, що хочете видалити %s?"

#. Translators: Title of the first column of the list view.
#: addon\globalPlugins\favoriteFolders\__init__.py:514
msgid "Nickname"
msgstr "Псевдонім"

#. Translators: Title of the second column of the list view.
#: addon\globalPlugins\favoriteFolders\__init__.py:521
msgid "Address"
msgstr "Адреса"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:21
msgid "Favorite folders and files - Register favorite folders and files"
msgstr "Улюблені папки та файли - реєструйте улюблені папки та файли"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid ""
"Register favorite folders and files to provide quick access to them. "
"Shortcuts:\n"
"WINDOWS+BACKSPACE: Open favorite folders dialog..\n"
"SHIFT+WINDOWS+BACKSPACE: Open favorite files dialog."
msgstr ""
"Зареєструйте улюблені папки та файли, щоб забезпечити швидкий доступ до "
"них. Комбінації:\n"
"WINDOWS+BACKSPACE: відкрити діалог улюблених папок..\n"
"SHIFT+WINDOWS+BACKSPACE: відкрити діалог улюблених  файлів."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:31
msgid ""
"Set compatibility with NVDA 2026.1;\n"
"Added Chai Chaimee work for favorite files."
msgstr ""
"Забезпечено сумісність із NVDA 2026.1;\n"
"Додано підтримку Chai Chaimee для файлів у списку обраних."

#~ msgid "&Add folder"
#~ msgstr "&Додати папку"

#~ msgid "&Open folder"
#~ msgstr "&Відкрити папку"
